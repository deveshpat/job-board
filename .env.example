# ---- Decision engine -------------------------------------------------------------------------
# Default: Kev-4B running locally on this Mac (free, private; bench/ shows it is the most accurate
# local engine we tested). ./run.sh starts it automatically. Kev lives in KEV_DIR (bench/engines/kev).
LOCAL_ENGINE=kev
KEV_RUN=jaredpalmer/kev-4b
KEV_DIR=bench/engines/kev
JEV_BASE_URL=http://127.0.0.1:8011
ENGINE_LABEL=Kev-4B

# To use TypeSafe's hosted Jev instead: comment out the five lines above and set
#   TYPESAFE_API_KEY=sk-...        (https://console.typesafe.ai/keys)
# or, via OpenRouter (no waitlist):
#   JEV_BASE_URL=https://openrouter.ai/api
#   JEV_MODEL=typesafe/jev-latest
#   TYPESAFE_API_KEY=<your OpenRouter key>
#   ENGINE_LABEL=Jev
TYPESAFE_API_KEY=

# Optional
# RESUME_PATH=/absolute/path/to/resume.tex   (optional: adopt this file on first start, keep it in sync)
# AVATAR_PATH=/absolute/path/to/photo.jpg
# PORT=8000
